      "name": "Simple Declutter",
      "slug": "simple-declutter",
      "teaser": "Removes clutter or shadows per map. Use on streets to lift performance.",
      "thumbnail": "https://forge-static.sp-tarkov.com/mods/2838.png",
      "downloads": 32712,
