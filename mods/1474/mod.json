    "data": {
      "id": 1474,
      "hub_id": 2032,
      "guid": "com.acidphantasm.disabletraitorscavs",
      "name": "Disable Traitor Scavs",
      "slug": "disable-traitor-scavs",
      "teaser": "Disables Traitor Scavs. You can also, alternatively, adjust the chance they do spawn instead of disabling them. Stop getting shot in the back!",
      "thumbnail": "https://forge-static.sp-tarkov.com/mods/2032.png",
      "downloads": 11178,
      "favourites_count": 19,
      "description": "<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">INSTALLATION</div>\n<div class=\"tab-content\"><p>Installation</p>\n<ol>\n<li>Download DisableTraitorScavs</li>\n<li>Open the downloaded 7z file in 7-zip</li>\n<li>Select the SPT folder in the 7z file in 7-zip</li>\n<li>Drag the SPT folder from 7-zip into your root SPT folder</li>\n</ol>\n<p>Demonstration Video (yoink):</p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/34vXXDj.gif\" alt=\"wMIskD3.gif\" /></p></div></div>\n<div id=\"tabset-1-panel-2\" class=\"tab-panel\"><div class=\"tab-title\">UNINSTALLATION</div>\n<div class=\"tab-content\"><ol>\n<li>Delete <code>/ROOTSPT/SPT/user/mods/acidphantasm-disabletraitorscavs</code></li>\n<li>Done</li>\n</ol></div></div>\n<div id=\"tabset-1-panel-3\" class=\"tab-panel\"><div class=\"tab-title\">CONFIG</div>\n<div class=\"tab-content\"><p>Config settings (\\config\\config.jsonc)</p>\n<ul>\n<li><strong>disableTraitorScavs</strong>\n<ul>\n<li><strong>Default: true</strong></li>\n<li><em>Change this to enable/disable traitor scavs</em></li>\n</ul>\n</li>\n<li><strong>traitorScavChance</strong>\n<ul>\n<li><strong>Default: 15</strong></li>\n<li><em>Percentage chance to spawn a traitor scav if above setting is false.</em></li>\n</ul>\n</li>\n</ul></div></div></div>\n<p>If you enjoy my work - you can <a target=\"_blank\" class=\"external-link\" href=\"https://ko-fi.com/acidphantasm\" rel=\"noreferrer noopener\">buy me a coffee</a>~</p>\n",
      "detail_url": "https://forge.sp-tarkov.com/mod/1474/disable-traitor-scavs",
