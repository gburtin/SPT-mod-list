    "data": {
      "id": 1657,
      "hub_id": 2262,
      "guid": "com.lacyway.mc",
      "name": "MergeConsumables",
      "slug": "mergeconsumables",
      "teaser": "Tired of not being able to merge your medical items or food? Now you can!",
      "thumbnail": "https://forge-static.sp-tarkov.com/mods/2262.png",
      "downloads": 69030,
      "favourites_count": 124,
      "description": "<h2>What is MergeConsumables?</h2>\n<p>MergeConsumables lets you merge (not stack!) any consumable item with a limited amount of uses, such as a bottle of water or an AFAK. Simply drag and drop one item on top of another item of the same type! For example, dragging an AFAK with 200/400 on to an AFAK with 50/400 would result in one item with 250/400!</p>\n<h2>What do I do if it didn’t work or want to report a bug/incompatibility?</h2>\n<p>Report the exact steps to reproduce the bug, and provide log files. I’ve tried as many cases as I can to find limitations, but it’s hard to find them all! A detailed report makes them easier to fix.</p>\n<h2>How do I install the mod?</h2>\n<p>Extract the contents of the .zip to your SPT install</p>\n<h3>You can support me on Ko-Fi</h3>\n<p><a target=\"_blank\" class=\"external-link\" href=\"https://ko-fi.com/lacyway\" rel=\"noreferrer noopener\">Click</a></p>\n",
      "detail_url": "https://forge.sp-tarkov.com/mod/1657/mergeconsumables",
      "fika_compatibility": true,
