  "mod": {
    "success": true,
    "data": {
      "id": 1343,
      "hub_id": 1861,
      "guid": "com.terkoiz.skipper",
      "name": "Skipper",
      "slug": "skipper",
      "teaser": "A small client mod for conveniently skipping quests",
      "thumbnail": "https://forge-static.sp-tarkov.com/mods/1861.png",
      "downloads": 307109,
      "favourites_count": 244,
      "description": "<p>Simply adds a “Skip” button next to quest conditions <strong>in the trader quest screens</strong>, letting you easily autocomplete any task.</p>\n<p>The default hotkey to make the Skip buttons appear is Left Control!<br />\n(you need to hold the button down)</p>\n<p>The binding can be changed in the F12 menu.</p>\n<p>Huge thanks to <a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/user/18717-amands2mello/\" rel=\"noreferrer noopener\">Amands2Mello</a> for the awesome mod icon</p>\n<p>Big thanks to <a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/user/24144-devraccoon/\" rel=\"noreferrer noopener\">Hazel</a> for compiling the 3.9 and 3.10 releases of this mod</p>\n<p><strong>Known issues:</strong></p>\n<ul>\n<li>Toggling the mod via configuration manager requires you to navigate away and back to the quest task screen for changes to apply</li>\n<li>Quest condition completion status isn’t saved to profile for now. Please only autocomplete conditions when you’re ready to actually complete the quest, otherwise the skipped conditions will reset to previous values after a raid or game restart!</li>\n</ul>\n<p><em>Self-control not included</em></p>\n",
      "detail_url": "https://forge.sp-tarkov.com/mod/1343/skipper",
      "fika_compatibility": false,
