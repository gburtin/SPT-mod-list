  "mod": {
    "success": true,
    "data": {
      "id": 1454,
      "hub_id": 2010,
      "guid": "com.cwx.megamod",
      "name": "CWX-MegaMod",
      "slug": "cwx-megamod",
      "teaser": "All my mods in one, BushWhacker, GrassCutter, EnvironmentEnjoyer, MasterKey, InventoryViewer, SpaceUser, TradingPlayerView, WeatherPatcher, PainkillerDesat, AlarmReplacer",
      "thumbnail": "https://forge-static.sp-tarkov.com/mods/2010.png",
      "downloads": 74986,
      "favourites_count": 45,
      "description": "<h4>This is my collection of mods, combined into one for easy use and development</h4>\n<p>Mod page is WIP, just wanted to get 4.0.0 version out the way.</p>\n<hr />\n<ul>\n<li>\n<h6>Main Mods</h6>\n</li>\n</ul>\n<ul>\n<li>BushWhacker - Lets you walk through bushes like the old days.</li>\n<li>GrassCutter - Removes grass for a 90’s viewing experience.</li>\n<li>MasterKey - Gives you the ability to use a Keycard for every door and lock in Tarkov.</li>\n<li>TradingPlayerView - (bad naming) this will remove the massive list from your view when hovering over a box trying to sell to a trader and it saying this cannot be sold.</li>\n<li>SpaceUser - This will give you the ability to buy from the flea by hitting space instead of (y) and will allow you to split ammo stacks aswell.</li>\n<li>EnvironmentEnjoyer - Takes GrassCutter to the extreme and removes tree’s and bushes.</li>\n<li>PainkillerDesat - Removes the visual effects of painkillers.</li>\n</ul>\n<hr />\n<ul>\n<li>\n<h6>Debug Mods (for debug use only)</h6>\n</li>\n</ul>\n<ul>\n<li>InstantSearch - Gives you the ability to instantly search all containers.</li>\n<li>FoodWater - Stops your PMC from loosing hydration and energy.</li>\n<li>LootLoss - Gets rid of loot locally for fast loading times.</li>\n<li>InventoryViewer - Gives you the ability to View secure containers.</li>\n<li>GodMode - Self explanatory.</li>\n<li>CameraShake - Removes the aimpunch from being shot.</li>\n<li>ThermalMode - Adds the ability to see in thermal.</li>\n<li>BetterThermalMode - Adds a less noisy version.</li>\n<li>NightVisionMode - Adds the ability to see in Night vision</li>\n</ul>\n<hr />\n<p>Any issues, please report them here <a target=\"_blank\" class=\"external-link\" href=\"https://github.com/CWXDEV/MegaMod/issues\" rel=\"noreferrer noopener\">https://github.com/CWXDEV/MegaMod/issues</a></p>\n",
